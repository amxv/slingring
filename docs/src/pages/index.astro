---
import { getCollection } from "astro:content";
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);

const proofPoints = [
  {
    title: "Your agents, one entrance",
    body: "Use the CLI locally or one authenticated MCP tool remotely. Both share the same queue and browser behavior."
  },
  {
    title: "Starts in Chat. Never Work.",
    body: "The extension verifies Chat mode and the requested reasoning level before sending your prompt."
  },
  {
    title: "A link, not a scraped answer",
    body: "Get the conversation URL after real thinking or streaming begins. Continue in ChatGPT while the local browser exits."
  },
  {
    title: "Quiet between tasks",
    body: "No idle browser, Redis, or polling queue. Local-only service exits; remote mode keeps one sleeping push connection."
  }
];
---

<BaseLayout
  title={`${siteConfig.name} | ${siteConfig.strapline}`}
  description={siteConfig.description}
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <section class="hero shell">
    <div class="hero__copy">
      <p class="section-label">A handoff to ChatGPT</p>
      <h1>Send the task.<br />Keep the link.</h1>
      <p class="hero__lede">
        Let your local and remote agents start a ChatGPT conversation for you.
        Slingring submits the brief, confirms that work has begun, returns the link,
        and gets the browser out of the way.
      </p>
      <div class="hero__actions">
        <a class="button button--solid" href="/docs/quickstart">Quickstart</a>
        <a class="button button--ghost" href="/docs">Browse docs</a>
      </div>
    </div>
    <aside class="hero__panel">
      <p class="hero__panel-label">From your terminal</p>
      <div class="hero__terminal">
        <span>$ slingring new-task \</span>
        <span>&nbsp;&nbsp;--prompt-file brief.md \</span>
        <span>&nbsp;&nbsp;--reasoning-effort "Extra High"</span>
        <span>https://chatgpt.com/c/…</span>
      </div>
    </aside>
  </section>

  <section class="shell section-grid">
    <div class="section-heading">
      <p class="section-label">One small bridge</p>
      <h2>Hand off the work without keeping another workspace alive.</h2>
      <p>
        A Rust CLI, a short-lived Chrome extension, and an optional native menu bar.
        Start tasks one at a time, queue a burst, and leave the actual conversation in ChatGPT.
      </p>
    </div>
    <div class="proof-grid">
      {proofPoints.map((item) => (
        <article class="proof-card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell docs-teaser">
    <div class="section-heading">
      <p class="section-label">Documentation</p>
      <h2>Start locally. Add remote access when you need it.</h2>
    </div>
    <div class="docs-teaser__grid">
      {docs.map((entry) => (
        <a class="docs-teaser__card" href={`/docs/${entry.id}`}>
          <span>{entry.data.category}</span>
          <h3>{entry.data.title}</h3>
          <p>{entry.data.summary ?? entry.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
<style>
  .slingring-home{--ember:#b7410e;--line:color-mix(in srgb,currentColor 16%,transparent);max-width:1180px;margin:auto;padding:24px 30px 70px}
  .landing-hero{display:grid;grid-template-columns:1.12fr 1fr;gap:76px;align-items:center;padding:66px 0 90px}
  .product-note{display:flex;align-items:center;gap:10px;font-size:13px;letter-spacing:.01em;margin:0 0 27px}.product-note>span{width:8px;height:8px;background:var(--ember);border-radius:50%}
  h1{font-size:clamp(48px,5.3vw,76px);line-height:1.03;letter-spacing:-.065em;font-weight:650;margin:0 0 26px}h1 em{font-style:normal;color:var(--ember)}
  .lede{font-size:17px;line-height:1.7;max-width:470px;opacity:.76;margin:0 0 28px}.actions{display:flex;align-items:center;gap:22px;flex-wrap:wrap;font-size:13px;font-weight:600}.actions a{text-decoration:none}.actions .primary{background:var(--ember);color:white;padding:13px 18px;border-radius:6px;display:flex;gap:22px}.actions .primary:hover{background:#97370e}.compatibility{font-size:11px;opacity:.55;margin-top:22px;line-height:1.8}
  .handoff{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:color-mix(in srgb,var(--ember) 2%,transparent);box-shadow:0 14px 40px #00000005}.handoff-header{display:flex;align-items:center;gap:12px;padding:21px 24px;border-bottom:1px solid var(--line);font-size:12px;font-weight:600}.portal{display:block;width:22px;height:22px;border:2px solid var(--ember);border-radius:50%;outline:1px solid color-mix(in srgb,var(--ember) 30%,transparent);outline-offset:4px;transform:rotate(-25deg) scaleX(.72)}
  .terminal,.returned{padding:24px 26px}.terminal-label{display:block;font:10px/1.4 ui-monospace,monospace;letter-spacing:.13em;opacity:.5;margin-bottom:18px}.terminal code,.returned code{font:13px/1.9 ui-monospace,SFMono-Regular,monospace;background:none;padding:0;border:0;word-break:break-word}.prompt{color:var(--ember)}.handoff-steps{padding:0 26px 22px;display:grid;gap:11px;font-size:12px;opacity:.75}.handoff-steps>span:before{content:'✓';color:var(--ember);padding-right:12px}.returned{border-top:1px solid var(--line)}.returned code{color:var(--ember);font-size:16px}.quiet{display:block;font-size:11px;opacity:.55;margin-top:15px}
  .ways{display:grid;grid-template-columns:.8fr 1fr 1fr;gap:42px;border-top:1px solid var(--line);padding:48px 0 60px}.section-note{font:10px ui-monospace,monospace;letter-spacing:.15em;opacity:.5;margin:0 0 18px}h2{font-size:30px;line-height:1.16;letter-spacing:-.045em;font-weight:600;margin:0}.ways>a{color:inherit;text-decoration:none;display:block}.ways>a:hover .learn{color:var(--ember)}.number{font:11px ui-monospace,monospace;opacity:.4}.ways h3{font-size:19px;letter-spacing:-.03em;margin:16px 0 10px}.ways p,.feature-grid p{font-size:14px;line-height:1.75;opacity:.67;margin:0}.learn{display:block;font-size:12px;font-weight:600;margin-top:20px}
  .principles{border-top:1px solid var(--line);padding:48px 0}.feature-grid{display:grid;grid-template-columns:1fr 1fr;gap:32px 70px;margin-top:32px}.feature-grid h3{font-size:16px;font-weight:600;margin:0 0 11px;letter-spacing:-.02em}.end-note{border-top:1px solid var(--line);padding-top:30px;display:flex;justify-content:space-between;gap:20px;font-size:12px;opacity:.7}.end-note p{margin:0}.end-note a{text-decoration:none}
  :global(.dark) .slingring-home{--ember:#f28c52}
  @media(max-width:850px){.landing-hero{gap:36px;grid-template-columns:1fr;padding-top:36px}.hero-copy{max-width:620px}.handoff{max-width:600px}.ways{grid-template-columns:1fr 1fr}.ways>div{grid-column:1/-1}.ways h2 br{display:none}.feature-grid{gap:28px 36px}}
  @media(max-width:500px){.slingring-home{padding:12px 20px 45px}.landing-hero{padding-bottom:50px}h1{font-size:52px}.ways,.feature-grid{grid-template-columns:1fr}.ways{gap:28px;padding:35px 0}.end-note{flex-direction:column}.handoff-header{padding:18px 20px}.terminal,.returned{padding:22px}.actions{gap:18px}.lede{font-size:16px}}
</style>
