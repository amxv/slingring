---
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";
import "../styles/landing.css";

const installCommand = "curl -fsSL https://slingring.ashray.xyz/install.sh | sh";
---

<BaseLayout
  title="Slingring | Delegate ChatGPT tasks from any agent"
  description="Let local and remote agents delegate tasks to your ChatGPT account. Start a chat, get its link, and steer it with follow-ups. CLI and MCP, powered by a headless browser on your Mac."
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <main class="sl">
    <div class="sl-topline" aria-label="Project overview">
      <span><span class="sl-topline__dot" aria-hidden="true"></span> OPEN SOURCE / BUILT FOR DELEGATION</span>
      <span>macOS <span aria-hidden="true">·</span> CLI <span aria-hidden="true">·</span> MCP</span>
    </div>

    <section class="sl-hero" aria-labelledby="hero-title">
      <div class="sl-hero__copy">
        <p class="sl-eyebrow"><span class="sl-eyebrow__number">01</span> A SMALL TOOL FOR A BIGGER TEAM</p>
        <h1 id="hero-title">Let any agent<br />delegate to <em>ChatGPT.</em></h1>
        <p class="sl-hero__lead">
          Give local and remote agents a simple way to start tasks in your ChatGPT account
          and steer them with follow-ups. Slingring handles the browser. Your agent gets the link.
        </p>
        <div class="sl-hero__actions">
          <a class="sl-button sl-button--primary" href="#install">Install Slingring <span aria-hidden="true">↗</span></a>
          <a class="sl-link" href="/docs/quickstart">Read the docs <span aria-hidden="true">↗</span></a>
        </div>
        <div class="sl-hero__notes" aria-label="Key capabilities">
          <span><span class="sl-hero__note-mark" aria-hidden="true"></span> Local CLI</span>
          <span><span class="sl-hero__note-mark" aria-hidden="true"></span> Remote MCP</span>
          <span><span class="sl-hero__note-mark" aria-hidden="true"></span> Headless by default</span>
        </div>
      </div>

      <div class="sl-hero__visual">
        <div class="sl-orbits" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="sl-trace" role="group" aria-label="Illustrative delegation flow, from agent request to ChatGPT conversation link">
          <div class="sl-trace__top">
            <span class="sl-logo" aria-hidden="true"><i></i><i></i></span>
            <span>SLINGRING <span class="sl-trace__top-light">/ TASK ROUTE</span></span>
            <span class="sl-trace__example">EXAMPLE</span>
          </div>
          <div class="sl-trace__body">
            <div class="sl-trace__step">
              <div class="sl-trace__rail"><span class="sl-trace__node">01</span></div>
              <div class="sl-trace__content">
                <div class="sl-trace__label"><span>YOUR AGENT</span><span class="sl-trace__chip">CLI OR MCP</span></div>
                <p class="sl-trace__prompt">“Draft a deployment plan, with a rollback checklist.”</p>
              </div>
            </div>
            <div class="sl-trace__step">
              <div class="sl-trace__rail"><span class="sl-trace__node">02</span></div>
              <div class="sl-trace__content">
                <div class="sl-trace__label"><span>SLINGRING ON YOUR MAC</span></div>
                <div class="sl-trace__browser"><span class="sl-trace__pulse" aria-hidden="true"></span> ChatGPT started thinking <span class="sl-trace__browser-tag">HEADLESS</span></div>
              </div>
            </div>
            <div class="sl-trace__step sl-trace__step--last">
              <div class="sl-trace__rail"><span class="sl-trace__node sl-trace__node--done">✓</span></div>
              <div class="sl-trace__content">
                <div class="sl-trace__label"><span>BACK TO YOUR AGENT</span><span class="sl-trace__success">LINK READY</span></div>
                <div class="sl-trace__url">chatgpt.com/c/your-chat-id <span aria-hidden="true">↗</span></div>
                <p class="sl-trace__followup">Have the link? Send another message to steer the task.</p>
              </div>
            </div>
          </div>
          <div class="sl-trace__bottom"><span>ONE CONVERSATION. AS MANY FOLLOW-UPS AS YOU NEED.</span><span aria-hidden="true">◌</span></div>
        </div>
      </div>
    </section>

    <div class="sl-manifesto" aria-label="What Slingring does">
      <span>START A CHATGPT TASK</span><span aria-hidden="true" class="sl-manifesto__star">✳</span>
      <span>GET THE CONVERSATION LINK</span><span aria-hidden="true" class="sl-manifesto__star">✳</span>
      <span>STEER IT WITH FOLLOW-UPS</span>
    </div>

    <section class="sl-route sl-section" id="how-it-works" aria-labelledby="route-title">
      <div class="sl-section__intro">
        <div>
          <p class="sl-eyebrow"><span class="sl-eyebrow__number">02</span> HOW IT WORKS</p>
          <h2 id="route-title">Two ways in.<br /><em>One place to delegate.</em></h2>
        </div>
        <p>Local agents use the CLI. Remote agents use MCP through your private relay. Both reach the same Slingring queue and browser on your Mac.</p>
      </div>

      <div class="sl-route__diagram" aria-label="Local CLI and remote MCP requests reach Slingring on the Mac, which starts ChatGPT tasks">
        <div class="sl-route__sources">
          <div class="sl-route__source">
            <span class="sl-micro">LOCAL / 01</span>
            <strong>CLI <span aria-hidden="true">↗</span></strong>
            <p>Coding agents, terminal tools</p>
          </div>
          <div class="sl-route__source">
            <span class="sl-micro">REMOTE / 02</span>
            <strong>MCP <span aria-hidden="true">↗</span></strong>
            <p>Always-on assistants, cloud agents</p>
            <span class="sl-route__via">VIA YOUR PRIVATE RELAY</span>
          </div>
        </div>
        <div class="sl-route__arrow" aria-hidden="true"><span></span></div>
        <div class="sl-route__center">
          <span class="sl-route__center-icon" aria-hidden="true"><i></i><i></i></span>
          <span class="sl-micro">RUNNING ON YOUR MAC</span>
          <h3>Slingring</h3>
          <p>One task queue.<br />An isolated, headless browser.</p>
        </div>
        <div class="sl-route__arrow" aria-hidden="true"><span></span></div>
        <div class="sl-route__destination">
          <span class="sl-micro">YOUR ACCOUNT</span>
          <div class="sl-route__chat-mark" aria-hidden="true">✳</div>
          <h3>ChatGPT</h3>
          <p>Chat starts.<br />Link goes back.</p>
        </div>
      </div>
      <p class="sl-route__note">No OpenAI API key needed. Local CLI calls work without a relay; remote MCP requires one-time setup in your own Cloudflare account.</p>
    </section>

    <section class="sl-interface sl-section" aria-labelledby="interface-title">
      <div class="sl-interface__copy">
        <p class="sl-eyebrow"><span class="sl-eyebrow__number">03</span> THE INTERFACE</p>
        <h2 id="interface-title">Just enough<br /><em>to delegate.</em></h2>
        <p>One command or one tool call to start a task. Another to follow up. Keep the ChatGPT URL and your agents can return to the same conversation.</p>
        <div class="sl-interface__links"><a class="sl-link" href="/docs/command-reference">CLI & MCP reference <span aria-hidden="true">↗</span></a></div>
      </div>

      <div class="sl-terminal">
        <div class="sl-terminal__header">
          <div class="sl-terminal__tabs" role="tablist" aria-label="Choose an interface">
            <button type="button" id="sl-cli-tab" role="tab" aria-selected="true" aria-controls="sl-cli-panel" data-surface="cli">CLI <span>LOCAL</span></button>
            <button type="button" id="sl-mcp-tab" role="tab" aria-selected="false" aria-controls="sl-mcp-panel" tabindex="-1" data-surface="mcp">MCP <span>REMOTE</span></button>
          </div>
          <span class="sl-terminal__file">TASK / FOLLOW-UP</span>
        </div>
        <div class="sl-terminal__panel" id="sl-cli-panel" role="tabpanel" aria-labelledby="sl-cli-tab">
          <p>Run from Claude Code or any agent on your Mac.</p>
          <pre><code><span class="sl-code-comment"># Delegate a task</span>
<span class="sl-code-prompt">$</span> slingring new-task --prompt-file task.md --json

<span class="sl-code-comment"># Steer it later with the returned link</span>
<span class="sl-code-prompt">$</span> slingring send-message \
    https://chatgpt.com/c/YOUR-CHAT-ID \
    "Add a rollback checklist"</code></pre>
          <a href="/docs/local-input">Local CLI guide <span aria-hidden="true">↗</span></a>
        </div>
        <div class="sl-terminal__panel" id="sl-mcp-panel" role="tabpanel" aria-labelledby="sl-mcp-tab" hidden>
          <p>Connect a remote agent to your private MCP URL.</p>
          <pre><code><span class="sl-code-comment">// Delegate a task</span>
new_task(&#123;
  prompt: "Draft a deployment plan"
&#125;)

<span class="sl-code-comment">// Steer it later with the returned link</span>
send_message(&#123;
  chatgpt_url: "https://chatgpt.com/c/...",
  message: "Add a rollback checklist"
&#125;)</code></pre>
          <a href="/docs/remote">Remote MCP guide <span aria-hidden="true">↗</span></a>
        </div>
        <div class="sl-terminal__footer"><span class="sl-terminal__status-dot" aria-hidden="true"></span> CLI SUPPORTS PROMPT FILES & IMAGES <span class="sl-terminal__footer-right">MCP IS TEXT-ONLY</span></div>
      </div>
    </section>

    <section class="sl-philosophy" aria-labelledby="philosophy-title">
      <span class="sl-philosophy__symbol" aria-hidden="true">◌</span>
      <div>
        <p class="sl-eyebrow"><span class="sl-eyebrow__number">04</span> BUILT TO GET OUT OF THE WAY</p>
        <h2 id="philosophy-title">The task keeps going.<br /><em>You keep the thread.</em></h2>
      </div>
      <p>Slingring confirms ChatGPT has started, then returns the conversation link. It doesn't read the answer, wait for completion, or retry a possibly submitted prompt. Follow-ups go straight to that same chat.</p>
    </section>

    <section class="sl-install" id="install" aria-labelledby="install-title">
      <div class="sl-install__heading">
        <div><p class="sl-eyebrow">READY WHEN YOUR AGENTS ARE</p><h2 id="install-title">Give them a way to <em>delegate.</em></h2></div>
        <a class="sl-install__docs" href="/docs/quickstart">Installation guide <span aria-hidden="true">↗</span></a>
      </div>
      <div class="sl-install__command">
        <code><span aria-hidden="true">$ </span>{installCommand}</code>
        <button type="button" class="sl-install__copy" data-copy={installCommand} aria-label="Copy install command">Copy <span aria-hidden="true">↗</span></button>
      </div>
      <div class="sl-install__under"><p>Apple Silicon Mac · Google Chrome · Signed-in ChatGPT account</p><p>No OpenAI API key required. <span class="sl-install__copy-status" role="status" aria-live="polite"></span></p></div>
    </section>
  </main>
</BaseLayout>

<script>
  const landing = document.querySelector<HTMLElement>(".sl");
  if (landing) {
    const tabs = [...landing.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const activate = (selectedTab: HTMLButtonElement) => {
      for (const tab of tabs) {
        const selected = tab === selectedTab;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute("aria-controls") || "");
        if (panel) panel.hidden = !selected;
      }
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : (index + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
        activate(tabs[next]);
        tabs[next].focus();
      });
    });

    const copy = landing.querySelector<HTMLButtonElement>(".sl-install__copy");
    copy?.addEventListener("click", async () => {
      const status = landing.querySelector<HTMLElement>(".sl-install__copy-status");
      try {
        await navigator.clipboard.writeText(copy.dataset.copy || "");
        if (status) status.textContent = "Install command copied.";
      } catch {
        if (status) status.textContent = "Select the command to copy it manually.";
      }
    });
  }
</script>
