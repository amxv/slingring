---
import { getCollection } from "astro:content";
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);

const proofPoints = [
  {
    title: "Your agents, one entrance",
    body: "Use the CLI locally or one authenticated MCP tool remotely. Both share the same queue and browser behavior."
  },
  {
    title: "Starts in Chat. Never Work.",
    body: "The extension verifies Chat mode and the requested reasoning level before sending your prompt."
  },
  {
    title: "A link, not a scraped answer",
    body: "Get the conversation URL after real thinking or streaming begins. Continue in ChatGPT while the local browser exits."
  },
  {
    title: "Quiet between tasks",
    body: "No idle browser, Redis, or polling queue. Local-only service exits; remote mode keeps one sleeping push connection."
  }
];
---

<BaseLayout
  title={`${siteConfig.name} | ${siteConfig.strapline}`}
  description={siteConfig.description}
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <section class="hero shell">
    <div class="hero__copy">
      <p class="section-label">A handoff to ChatGPT</p>
      <h1>Send the task.<br />Keep the link.</h1>
      <p class="hero__lede">
        Let your local and remote agents start a ChatGPT conversation for you.
        Slingring submits the brief, confirms that work has begun, returns the link,
        and gets the browser out of the way.
      </p>
      <div class="hero__actions">
        <a class="button button--solid" href="/docs/quickstart">Quickstart</a>
        <a class="button button--ghost" href="/docs">Browse docs</a>
      </div>
    </div>
    <aside class="hero__panel">
      <p class="hero__panel-label">From your terminal</p>
      <div class="hero__terminal">
        <span>$ slingring new-task \</span>
        <span>&nbsp;&nbsp;--prompt-file brief.md \</span>
        <span>&nbsp;&nbsp;--reasoning-effort "Extra High"</span>
        <span>https://chatgpt.com/c/…</span>
      </div>
    </aside>
  </section>

  <section class="shell section-grid">
    <div class="section-heading">
      <p class="section-label">One small bridge</p>
      <h2>Hand off the work without keeping another workspace alive.</h2>
      <p>
        A Rust CLI, a short-lived Chrome extension, and an optional native menu bar.
        Start tasks one at a time, queue a burst, and leave the actual conversation in ChatGPT.
      </p>
    </div>
    <div class="proof-grid">
      {proofPoints.map((item) => (
        <article class="proof-card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell docs-teaser">
    <div class="section-heading">
      <p class="section-label">Documentation</p>
      <h2>Start locally. Add remote access when you need it.</h2>
    </div>
    <div class="docs-teaser__grid">
      {docs.map((entry) => (
        <a class="docs-teaser__card" href={`/docs/${entry.id}`}>
          <span>{entry.data.category}</span>
          <h3>{entry.data.title}</h3>
          <p>{entry.data.summary ?? entry.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
