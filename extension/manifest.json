{
  "manifest_version": 3,
  "name": "Slingring",
  "version": "0.1.0",
  "minimum_chrome_version": "156",
  "description": "Start an explicitly requested ChatGPT chat, report its URL, and stop. No answer extraction.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "dom.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
